DirectoryIndex BINGO_MASTER_CURRENT_VERIFIED.html

# Surgical presentation/performance injections — master HTML and Supabase/media/message wiring remain untouched.
AddOutputFilterByType SUBSTITUTE text/html
Substitute "s|</head>|<link rel='stylesheet' href='/assets/bingo-wall-white-2026-10-02.css?v=20261002'><script defer src='/assets/bingo-wall-white-2026-10-02.js?v=20261002'></script><link rel='stylesheet' href='/assets/bingo-messenger-white-colorful-2026-10-02.css?v=20261002'><script defer src='/assets/bingo-messenger-white-colorful-2026-10-02.js?v=20261002'></script><link rel='stylesheet' href='/assets/bingo-performance-feedback-2026-10-02.css?v=20261002'><script defer src='/assets/bingo-performance-feedback-2026-10-02.js?v=20261002'></script><script defer src='/assets/bingo-home-landing-repair-2026-10-02.js?v=20261002DELETE'></script><script defer src='/assets/bingo-performance-bootstrap.js?v=20261005'></script><script defer src='/assets/bingo-home-feed-clean-override.js?v=20261005'></script><script defer src='/assets/bingo-social-graph-addon.js?v=20261005'></script><script defer src='/assets/bingo-paid-crowns-addon.js?v=20261005'></script><script defer src='/assets/bingo-topic-composer-cleanup.js?v=20261005'></script><script defer src='/assets/bingo-font-restoration.js?v=20261005'></script><script defer src='/assets/bingo-mobile-stability-2026-10-05.js?v=20261005'></script><script defer src='/assets/bingo-voice-live-plus.js?v=20261005'></script><script defer src='/assets/bingo-categories-direct.js?v=20261005'></script><script defer src='/assets/bingo-vehicle-form-scope-repair.js?v=20261005'></script><script defer src='/assets/bingo-home-legacy-avatar-lock.js?v=20261005'></script><script defer src='/assets/bingo-vehicle-category-browse-repair.js?v=20261005'></script><script defer src='/assets/bingo-vehicle-details-compact-actions.js?v=20261005'></script><script defer src='/assets/bingo-video-feed-viewport.js?v=20261005'></script><script defer src='/assets/bingo-views-crowns-scope.js?v=20261005'></script><script defer src='/assets/bingo-home-top-logo-authority.js?v=20261005'></script><script defer src='/assets/bingo-media-stability.js?v=20261005'></script></head>|n